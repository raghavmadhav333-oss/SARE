{
  "hotkey": "win+ctrl+r",
  "dismiss_key": "esc",
  "display_seconds": 10,
  "fade_step_ms": 20,
  "max_opacity": 0.85,
  "window_width_ratio": 0.25,
  "aspect_ratio": [16, 9],
  "no_repeat_history": 3,
  "images_dir": "images/",
